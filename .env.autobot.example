# Autobot — Web Account Registration Agent
# Copy to .env and fill values. This file is safe to commit.

# Browser mode: set false to watch the browser open (useful for debugging)
AUTOBOT_HEADLESS=true

# Optional: residential proxy URL to avoid VPS IP blocks
# Format: socks5://user:pass@host:port  OR  http://user:pass@host:port
AUTOBOT_PROXY=

# Seconds to wait for verification email before timing out
AUTOBOT_TIMEOUT=300

# Where to store credentials, sessions, and screenshots
AUTOBOT_WORKSPACE=./workspace
